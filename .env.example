# Application
APP_ENV=development
APP_PORT=8080

# Database URLs — isi dengan connection string masing-masing
DATABASE_URL=postgresql://postgres:your-password@db.xxx.supabase.co:5432/postgres?sslmode=require
REDIS_URL=redis://:your-password@localhost:6379/0
MONGO_URI=mongodb://localhost:27017/go-produk
MONGO_DATABASE=go-produk

# Pool settings (opsional, pakai default jika tidak diisi)
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m
REDIS_POOL_SIZE=10
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10
MONGO_TIMEOUT=10s

# Key Omniroute
# sk-e2c8059dc470942f-433f3a-9134e4f2

# Supabase Auth (untuk login Google via Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback